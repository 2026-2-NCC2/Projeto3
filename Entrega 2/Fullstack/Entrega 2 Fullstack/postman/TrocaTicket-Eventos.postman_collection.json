{
  "info": {
    "_postman_id": "7f3c2a10-trocaticket-eventos-entrega2",
    "name": "TrocaTicket - Eventos e Comércio v3",
    "description": "CRUD acadêmico e comércio integrado. Use a pasta Comércio para catálogo, reserva e compra. Os IDs são salvos pelas respostas.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "eventoId",
      "value": "",
      "type": "string"
    },
    {
      "key": "visitor",
      "value": "postman-visitante-1234567890",
      "type": "string"
    },
    {
      "key": "reservaId",
      "value": "",
      "type": "string"
    },
    {
      "key": "loteId",
      "value": "",
      "type": "string"
    },
    {
      "key": "ingressoId",
