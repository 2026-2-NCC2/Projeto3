# Copie para .env e ajuste. O .env NÃO deve ser versionado.

# Porta HTTP (API + front-end)
PORT=3000
NODE_ENV=development

# Autenticação (OBRIGATÓRIO em produção: use uma chave longa e aleatória)
# AUTH_SECRET=defina-uma-chave-aleatoria-em-producao
AUTH_TOKEN_TTL_HORAS=8

# MySQL 8.0+
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=trocaticket_app
DB_PASSWORD=troque-por-uma-senha-forte
DB_NAME=trocaticket
DB_POOL_LIMIT=10

# Origem permitida para CORS (URL do front-end publicado em outro domínio)
CORS_ORIGIN=*
